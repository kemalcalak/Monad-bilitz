# ============== DATABASE CONFIGURATION ==============
POSTGRES_USER=monad_user
POSTGRES_PASSWORD=monad_password_123
POSTGRES_DB=monad_bilitz
# Use "localhost" for local runs, "db" when running inside docker-compose
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============== REDIS CONFIGURATION ==============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============== JWT AUTHENTICATION ==============
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# ============== MONAD TESTNET CONFIGURATION ==============
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_WSS_URL=wss://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# Admin Wallet Private Key (for contract deployment and transactions)
ADMIN_WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ============== SMART CONTRACT ADDRESSES ==============
# Deploy contracts first using: cd contracts && npx hardhat run scripts/deploy.js --network monadTestnet
HIERARCHY_MANAGER_ADDRESS=0x...
SIGNATURE_AUTHORITY_ADDRESS=0x...

# ============== OPENAI API ==============
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============== SOCKET.IO CONFIGURATION ==============
SOCKETIO_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080"]

# ============== HKAS CRYPTOGRAPHY SETTINGS ==============
# Generate key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HKAS_ENCRYPTION_KEY=generate-with-fernet-key-gen
PRIME_FIELD_BITS=256
DEFAULT_SECURITY_LEVEL=128
DEFAULT_BETA=2
